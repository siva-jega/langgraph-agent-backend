# ===========================================
# RUNTIME / OBSERVABILITY
# ===========================================
# Deployment environment label. Controls dev-only behaviors (e.g. workflow auto-disables
# OTLP export when "development"). Set to "production" or "staging" in deployed envs.
ENVIRONMENT="development"
# Log output format: "json" (structured, with correlation_id/trace_id/span_id for
# log-to-trace in Loki/Grafana/Datadog) or "console" (human-readable, local dev only).
# Defaults to "json" everywhere; set "console" locally if you want readable logs.
LOG_FORMAT="json"
# OpenTelemetry trace export. Leave OTEL_DISABLE unset/false in deployments and point
# the OTLP endpoint at your collector so spans (and trace/span IDs in logs) are exported.
# OTEL_DISABLE="false"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://otel-collector:4317"

OPENAI_API_KEY=""
# LiteLLM or OpenAI-compatible base (required for embeddings, agents, Shopify product relevance, etc.)
OPENAI_API_BASE=""
# Optional: OpenAI Priority Processing — set to "priority" for lower latency (requires Priority enabled on the OpenAI project).
# OPENAI_SERVICE_TIER=priority
# Optional: model id for Shopify get_products AI relevance filter (default: openai/gpt-4.1-mini)
# SHOPIFY_PRODUCT_VALIDATION_MODEL=openai/gpt-4.1-mini
# Headroom tool-output compression (Phase 1). ON by default for staging testing; set
# HEADROOM_ENABLED=false to disable. Compresses large tool results (JSON/search/logs)
# before they re-enter the LLM context. Telemetry off.
# HEADROOM_ENABLED=true
# HEADROOM_MIN_TOKENS_TO_COMPRESS=100
# HEADROOM_PRESERVE_ERRORS=true
HEADROOM_TELEMETRY=off
JWT_SECRET=""

# ===========================================
# NESTJS USER-BACKEND (handoff internal API + inbox Live tab)
# ===========================================
# Base URL of the NestJS API (reachable from this process — use internal K8s URL in cluster).
# Set NESTJS_URL explicitly for internal API calls (see common/core/nestjs_staging_defaults.py).
NESTJS_URL="http://localhost:3000"
# Must match user-backend WS_INTERNAL_SECRET (x-internal-secret).
NESTJS_INTERNAL_SECRET="change-me-internal-secret"
# Optional aliases:
# BACKEND_URL=...  USER_BACKEND_URL=...  INTERNAL_SECRET=...  WS_INTERNAL_SECRET=...
MILVUS_URI=""
MILVUS_TOKEN=""
AWS_ACCESS_KEY=""
AWS_KEY_SECRET=""
AWS_DEFAULT_REGION=""
SYSTEM_USER_TOKEN=""
# Channels inbound SQS subscriber (standalone test script)
CHANNELS_INBOUND_QUEUE_URL=""
CHANNELS_AWS_REGION=""
ENCRYPTION_KEY=""
TAVILY_API_KEY=""
# PostgreSQL: checkpointer for LangGraph (optional; falls back to MemorySaver)
CHECKPOINTER_URL=""
# PostgreSQL: app data (chats, messages, usage, tickets, leads) - same DB as user-backend
DATABASE_URL=""
FIRECRAWL_API_KEY=""
RIZA_API_KEY=""
# Cal.com: OAuth app client ID and secret (same as user-backend). Required for Cal.com tools when using OAuth; ai-backend sends these as x-cal-client-id / x-cal-secret-key so event-types/slots/bookings work with third-party OAuth tokens.
CALCOM_CLIENT_ID=""
CALCOM_CLIENT_SECRET=""
# Optional: CALCOM_ACCESS_TOKEN for scripts/calcom-curl.sh (copy from app after connecting Cal.com via OAuth).

# User-backend webhooks (WhatsApp Flow send tool, token refresh, etc.)
INTERNAL_WEBHOOK_SECRET=

# Sentry
SENTRY_DSN=""

# ===========================================
# LangSmith — eval platform (NOT used for prod tracing)
# ===========================================
# Used only by the evals module to push datasets + experiments to LangSmith
# and to trace each scored case during an `evaluate(...)` run. Production
# and staging traffic is NOT auto-traced — only eval runs are. See
# EVAL_PLAN.md for the full eval rollout.
#
# Set LANGSMITH_API_KEY before running `python -m app.modules.evals.cli`.
# LANGSMITH_TRACING=true is set automatically by the eval runner during a
# run; you don't need to flip it manually for normal agent traffic.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="web-agent-evals"
# LANGSMITH_ENDPOINT defaults to https://api.smith.langchain.com
